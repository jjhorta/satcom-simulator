# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate with: python3 -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('YOUR_PASSWORD'))"
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLE_HASH_REPLACE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Directories (set automatically by docker-compose; override here if needed) ─
# OUTPUTS_DIR=/app/outputs
# SIMULATOR_ROOT=/app/simulator

# ── CORS origins (comma-separated, no trailing slash) ─────────────────────────
# For local dev: http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173
